            &quot;@type&quot;: &quot;Answer&quot;
          }
        },
        {
          &quot;name&quot;: &quot;Will AI replace data analysts in India?&quot;,
          &quot;@type&quot;: &quot;Question&quot;,
          &quot;acceptedAnswer&quot;: {
            &quot;text&quot;: &quot;No. AI is not replacing data analyst jobs, but it is reshaping how the work is done. Analysts who learn to use AI to work more efficiently benefit rather than lose out.&quot;,
            &quot;@type&quot;: &quot;Answer&quot;
          }
        },
        {
          &quot;name&quot;: &quot;Which AI tool is best for dashboards and reporting?&quot;,
          &quot;@type&quot;: &quot;Question&quot;,
          &quot;acceptedAnswer&quot;: {
            &quot;text&quot;: &quot;Power BI Copilot and Tableau AI are strong options for dashboards and reporting. They automate the creation of visual reports and offer faster AI-driven business insights.&quot;,
            &quot;@type&quot;: &quot;Answer&quot;
          }
        },
        {
          &quot;name&quot;: &quot;Do I need coding skills to use AI tools in analytics?&quot;,
          &quot;@type&quot;: &quot;Question&quot;,
          &quot;acceptedAnswer&quot;: {
            &quot;text&quot;: &quot;Not strictly. Tools such as Polymer, Julius AI, and Gemini work with plain-English commands. Basic SQL and Python knowledge does open up wider career growth and job opportunities.&quot;,
            &quot;@type&quot;: &quot;Answer&quot;
          }
        },
        {
          &quot;name&quot;: &quot;What salary can AI-skilled data analysts expect in India?&quot;,
          &quot;@type&quot;: &quot;Question&quot;,
          &quot;acceptedAnswer&quot;: {
            &quot;text&quot;: &quot;An AI-skilled data analyst can expect between ₹4–8 LPA in India, depending on skills, projects, and job location.&quot;,
            &quot;@type&quot;: &quot;Answer&quot;
          }
        }
