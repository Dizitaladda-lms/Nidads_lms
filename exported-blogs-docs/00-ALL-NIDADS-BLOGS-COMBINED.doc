          &quot;acceptedAnswer&quot;: {
            &quot;text&quot;: &quot;Freshers in India typically earn ₹6–8 LPA at entry level. In the US, entry-level salaries range from $100,000–$140,000 per year.&quot;,
            &quot;@type&quot;: &quot;Answer&quot;
