          &quot;@type&quot;: &quot;Question&quot;,
          &quot;acceptedAnswer&quot;: {
            &quot;text&quot;: &quot;AI is only capturing basic or repetitive parts of the job, such as basic code generation. Companies still need people who can build data-driven strategies, apply AI tools, and solve business problems with real judgment.&quot;,
            &quot;@type&quot;: &quot;Answer&quot;
          }
        },
        {
          &quot;name&quot;: &quot;How long does it take to get a job in data science after a course?&quot;,
          &quot;@type&quot;: &quot;Question&quot;,
          &quot;acceptedAnswer&quot;: {
            &quot;text&quot;: &quot;With a structured programme that includes hands-on project work and placement support, most students land their first role within 3 to 6 months of completing the course.&quot;,
            &quot;@type&quot;: &quot;Answer&quot;
          }
        },
        {
          &quot;name&quot;: &quot;Which industries in India hire the most data science professionals?&quot;,
          &quot;@type&quot;: &quot;Question&quot;,
          &quot;acceptedAnswer&quot;: {
            &quot;text&quot;: &quot;Banking and fintech lead hiring, followed by e-commerce, IT, and healthcare, giving the field wide scope across industries.&quot;,
            &quot;@type&quot;: &quot;Answer&quot;
          }
        }
      ]
    },
    {
      &quot;@id&quot;: &quot;https://www.nidads.com/blog/data-science-career-india-2026#speakable&quot;,
      &quot;@type&quot;: &quot;SpeakableSpecification&quot;,
      &quot;xpath&quot;: [
        &quot;/html/head/title&quot;,
        &quot;//*[@id='salary-table']&quot;,
        &quot;//*[@id='faq']&quot;
      ],
      &quot;cssSelector&quot;: [
        &quot;h1&quot;,
        &quot;.salary-table&quot;,
        &quot;.faq-section&quot;
