          &quot;@type&quot;: &quot;Question&quot;,
          &quot;acceptedAnswer&quot;: {
            &quot;text&quot;: &quot;Depends entirely on the task. Harder problems need more, though transfer learning can lower that bar.&quot;,
            &quot;@type&quot;: &quot;Answer&quot;
          }
        }
