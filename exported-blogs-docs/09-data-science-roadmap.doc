      &quot;step&quot;: [
        {
          &quot;name&quot;: &quot;Learn basic math&quot;,
          &quot;text&quot;: &quot;Linear algebra, calculus, and probability — just enough to understand how a model learns.&quot;,
          &quot;@type&quot;: &quot;HowToStep&quot;,
          &quot;position&quot;: 1
        },
        {
          &quot;name&quot;: &quot;Learn Python&quot;,
          &quot;text&quot;: &quot;Syntax first, then pandas and numpy, since that's what you'll use daily once you're working with real data.&quot;,
          &quot;@type&quot;: &quot;HowToStep&quot;,
          &quot;position&quot;: 2
        },
        {
          &quot;name&quot;: &quot;Learn SQL&quot;,
          &quot;text&quot;: &quot;SELECT, JOIN, GROUP BY, window functions. Most data lives in a database, not a CSV.&quot;,
          &quot;@type&quot;: &quot;HowToStep&quot;,
          &quot;position&quot;: 3
        },
        {
          &quot;name&quot;: &quot;Learn statistics and probability&quot;,
          &quot;text&quot;: &quot;Distributions, hypothesis testing, correlation vs. causation — the stage most self-taught learners quietly skip.&quot;,
          &quot;@type&quot;: &quot;HowToStep&quot;,
          &quot;position&quot;: 4
        },
        {
          &quot;name&quot;: &quot;Learn data visualization&quot;,
          &quot;text&quot;: &quot;Matplotlib/seaborn for exploring data, one BI tool (Power BI or Tableau) for presenting it.&quot;,
          &quot;@type&quot;: &quot;HowToStep&quot;,
          &quot;position&quot;: 5
        },
        {
          &quot;name&quot;: &quot;Learn machine learning&quot;,
          &quot;text&quot;: &quot;Regression, classification, ensembles, evaluation metrics via scikit-learn.&quot;,
          &quot;@type&quot;: &quot;HowToStep&quot;,
          &quot;position&quot;: 6
        },
        {
          &quot;name&quot;: &quot;Learn deep learning and generative AI&quot;,
          &quot;text&quot;: &quot;Neural network basics, then PyTorch or TensorFlow, plus enough LLM and RAG knowledge to be useful in 2026.&quot;,
          &quot;@type&quot;: &quot;HowToStep&quot;,
          &quot;position&quot;: 7
        },
        {
          &quot;name&quot;: &quot;Learn cloud and MLOps&quot;,
          &quot;text&quot;: &quot;One platform (AWS, Azure, or GCP), Docker basics, and enough vocabulary to explain production.&quot;,
          &quot;@type&quot;: &quot;HowToStep&quot;,
          &quot;position&quot;: 8
        }
      ],
      &quot;@type&quot;: &quot;HowTo&quot;,
