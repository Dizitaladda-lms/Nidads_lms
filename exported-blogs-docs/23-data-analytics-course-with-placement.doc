        {
          &quot;name&quot;: &quot;What is the difference between a data analyst and a business analyst?&quot;,
          &quot;@type&quot;: &quot;Question&quot;,
          &quot;acceptedAnswer&quot;: {
            &quot;text&quot;: &quot;A data analyst focuses on extracting, cleaning, and visualizing data to answer specific questions. A business analyst applies similar data skills but centers on business process improvement, requirements gathering, and stakeholder strategy.&quot;,
            &quot;@type&quot;: &quot;Answer&quot;
