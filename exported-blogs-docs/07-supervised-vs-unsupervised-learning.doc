      &quot;step&quot;: [
        {
          &quot;name&quot;: &quot;Check whether a target variable already exists&quot;,
          &quot;text&quot;: &quot;Look for recorded outcomes in the data, such as fraud/not fraud or churn/retained.&quot;,
